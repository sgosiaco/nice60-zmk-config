#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/reset.h>
#include <dt-bindings/zmk/ext_power.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&gresc     &kp N1    &kp N2  &kp N3    &kp N4  &kp N5  &kp N6     &kp N7  &kp N8     &kp N9   &kp N0    &kp MINUS  &kp EQUAL  &kp BSPC
&kp TAB    &kp Q     &kp W   &kp E     &kp R   &kp T   &kp Y      &kp U   &kp I      &kp O    &kp P     &kp LBKT   &kp RBKT   &kp BSLH
&mo 1      &kp A     &kp S   &kp D     &kp F   &kp G   &kp H      &kp J   &kp K      &kp L    &kp SEMI  &kp SQT               &kp RET
&kp LSHFT  &kp Z     &kp X   &kp C     &kp V   &kp B   &kp N      &kp M   &kp COMMA  &kp DOT  &kp FSLH                        &mo 1
&kp LCTRL  &kp LGUI          &kp LALT                  &kp SPACE                              &kp RALT  &kp RGUI   &mo 2      &kp RCTRL
            >;
        };

        layer_2 {
            bindings = <
&kp GRAVE  &kp F1              &kp F2          &kp F3               &kp F4                  &kp F5      &kp F6    &kp F7         &kp F8  &kp F9  &kp F10          &kp F11           &kp F12         &kp RC(BACKSPACE)
&trans     &kp LC(LEFT_ARROW)  &kp UP_ARROW    &kp RC(RIGHT_ARROW)  &kp LC(LA(UP_ARROW))    &trans      &trans    &trans         &trans  &trans  &kp PRINTSCREEN  &kp C_PLAY_PAUSE  &kp SCROLLLOCK  &trans
&trans     &kp LEFT_ARROW      &kp DOWN_ARROW  &kp RIGHT_ARROW      &kp LC(LA(DOWN_ARROW))  &kp INSERT  &kp HOME  &kp PAGE_UP    &trans  &trans  &kp C_PREVIOUS   &kp C_NEXT                        &trans
&trans     &trans              &trans          &trans               &trans                  &kp DELETE  &kp END   &kp PAGE_DOWN  &trans  &trans  &trans                                             &trans
&trans     &trans                              &trans                                                   &trans                                   &trans           &trans            &trans          &trans
            >;
        };

        rgb_layer {
            bindings = <
&bt BT_CLR    &bt BT_CLR_ALL   &trans           &trans           &trans           &trans  &trans  &trans  &trans  &trans  &trans        &trans            &trans  &bootloader
&bt BT_SEL 0  &rgb_ug RGB_TOG  &rgb_ug RGB_EFF  &rgb_ug RGB_EFR  &trans           &trans  &trans  &trans  &trans  &trans  &trans        &trans            &trans  &trans
&bt BT_SEL 1  &rgb_ug RGB_HUI  &rgb_ug RGB_HUD  &rgb_ug RGB_SAI  &rgb_ug RGB_SAD  &trans  &trans  &trans  &trans  &trans  &trans        &trans                    &trans
&bt BT_SEL 2  &rgb_ug RGB_BRI  &rgb_ug RGB_BRD  &rgb_ug RGB_SPI  &rgb_ug RGB_SPD  &trans  &trans  &trans  &trans  &trans  &out OUT_BLE                            &out OUT_USB
&bt BT_SEL 3  &trans                            &trans                                    &trans                          &trans        &ext_power EP_ON  &trans  &ext_power EP_OFF
            >;
        };
    };
};
